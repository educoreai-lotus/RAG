# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_dev

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKER_URL=localhost:9092
KAFKA_CLIENT_ID=rag-microservice
KAFKA_GROUP_ID=rag-microservice-consumers

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_URL=https://api.openai.com/v1

# Guest chat (public nAuth widget final-answer gate)
# Non-secret feature flag. Default false. Authenticated hosts are unaffected.
# Set true only after review; restart/redeploy required.
GUEST_CHAT_ENABLED=false

# Temporary diagnostic logging for Guest vs authenticated Directory answer divergence.
# Backend-only. Missing or any value other than exact lowercase "true" disables tracing.
# When enabled: emits [RAG CROSS HOST TRACE] JSON logs and X-RAG-Trace-Id response header.
# Does not change answers, retrieval, cache, prompts, or Guest gate decisions.
# Disable after collecting evidence (set false and restart/redeploy).
RAG_CROSS_HOST_TRACE_ENABLED=false

# EDUCORE Services
LEARNER_AI_SERVICE_URL=https://learner-ai.educore.local
SKILLS_ENGINE_SERVICE_URL=https://skills-engine.educore.local
ASSESSMENT_SERVICE_URL=https://assessment.educore.local
DEVLAB_SERVICE_URL=https://devlab.educore.local
ANALYTICS_SERVICE_URL=https://analytics.educore.local
CONTENT_SERVICE_URL=https://content.educore.local

# Coordinator Service (gRPC - for intelligent routing to microservices)
COORDINATOR_ENABLED=true
COORDINATOR_URL=coordinator
COORDINATOR_GRPC_PORT=50051
COORDINATOR_GRPC_URL=coordinator:50051
COORDINATOR_PROTO_PATH=../DATABASE/proto/rag/v1/coordinator.proto
COORDINATOR_SERVICE_NAME=rag.v1.CoordinatorService
GRPC_TIMEOUT=30

# Security - Cryptographic Signatures
# Generate with: openssl ecparam -genkey -name prime256v1 -noout -out private.pem && base64 -i private.pem
RAG_PRIVATE_KEY=<base64-encoded-PEM-private-key>
# Optional: Coordinator's public key for signature verification
COORDINATOR_PUBLIC_KEY=<base64-encoded-PEM-public-key-optional>

# gRPC SSL/TLS (Production)
# Set to 'true' to use SSL/TLS encryption for gRPC connections
GRPC_USE_SSL=false
# Optional: Custom root certificate (base64 encoded)
# GRPC_ROOT_CERT=<base64-encoded-root-certificate>

# AI LEARNER Microservice (gRPC - for learning recommendations)
AI_LEARNER_GRPC_URL=ai-learner.educore.local:50051
AI_LEARNER_ENABLED=true
AI_LEARNER_PROTO_PATH=../DATABASE/proto/rag/v1/personalized.proto
AI_LEARNER_SERVICE_NAME=rag.v1.PersonalizedService

# Supabase
SUPABASE_URL=https://supabase.educore.local
SUPABASE_ANON_KEY=your-supabase-anon-key

